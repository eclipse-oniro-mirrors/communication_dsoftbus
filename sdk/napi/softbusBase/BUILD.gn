import("../../../dsoftbus.gni")

ohos_shared_library("softbusbase") {
  sources = []
  deps = []
  external_deps = []
  if (!dsoftbus_feature_compile_guard) {
    include_dirs = [
      "$dsoftbus_root_path/interfaces/kits/bus_center",
      "$dsoftbus_root_path/interfaces/inner_kits/lnn",
      "$dsoftbus_root_path/interfaces/kits/adapter",
      "$dsoftbus_sdk_path/napi/softbusBase/include",
    ]

    sources += [
      "$dsoftbus_sdk_path/napi/softbusBase/src/napi_softbus_base.cpp",
      "$dsoftbus_sdk_path/napi/softbusBase/src/napi_softbus_base_utils.cpp",
    ]

    deps += [
      "$dsoftbus_dfx_path:softbus_dfx",
      "$dsoftbus_root_path/adapter:softbus_adapter",
      "$dsoftbus_root_path/core/common:softbus_utils",
      "$dsoftbus_root_path/sdk:softbus_client",
      "$dsoftbus_dfx_path/dumper/legacy:softbus_dfx_dump",
    ]

    external_deps = [
      "c_utils:utils",
      "access_token:libaccesstoken_sdk",
      "access_token:libtokenid_sdk",
      "ipc:ipc_core",
      "bounds_checking_function:libsec_shared",
      "hilog:libhilog",
      "napi:ace_napi",
      "node:node_header_notice",
    ]
  } else {
    include_dirs = [
      "$dsoftbus_sdk_path/napi/softbusBase/include",
    ]
    external_deps += [
      "napi:ace_napi",
      "node:node_header_notice",
    ]
    sources += [
      "$dsoftbus_sdk_path/napi/softbusBase/virtual/napi_softbus_base_virtual.cpp",
    ]
  }

  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  branch_protector_ret = "pac_ret"

  relative_install_dir = "module/distributed"

  subsystem_name = "communication"
  part_name = "dsoftbus"
}
